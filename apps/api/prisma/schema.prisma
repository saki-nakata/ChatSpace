// ChatSpace データベーススキーマ
// プロトタイプでは SQLite を使用する。本番相当の運用では PostgreSQL 等への移行を検討すること。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  userId       String   @unique // ログインID（表示上のハンドル、@メンションにも使用）
  passwordHash String
  displayName  String
  avatarUrl    String?
  status       String?
  createdAt    DateTime @default(now())

  ownedWorkspaces   Workspace[]        @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  channelMembers    ChannelMember[]
  messages          Message[]
  reactions         Reaction[]
  attachments       Attachment[]
  notifications     Notification[]    @relation("NotificationRecipient")
  sentNotifications Notification[]    @relation("NotificationSender")
  dmAsUserA         DMThread[]        @relation("DMUserA")
  dmAsUserB         DMThread[]        @relation("DMUserB")
}

// SQLite は enum 型をサポートしないため String で表現する。
// 取りうる値は @chatspace/shared の型定義側で厳密に管理する。
// WorkspaceRole: "OWNER" | "MEMBER"
// ChannelType:   "PUBLIC" | "PRIVATE"
// AttachmentKind: "IMAGE" | "VIDEO"
// NotificationType: "MENTION" | "DM" | "CHANNEL_INVITE" | "WORKSPACE_INVITE"

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members       WorkspaceMember[]
  channels      Channel[]
  dmThreads     DMThread[]
  notifications Notification[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String        @default("MEMBER")
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
}

model Channel {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        String // "PUBLIC" | "PRIVATE"
  createdAt   DateTime  @default(now())

  members  ChannelMember[]
  messages Message[]

  @@unique([workspaceId, name])
}

model ChannelMember {
  id         String    @id @default(cuid())
  channelId  String
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime  @default(now())

  @@unique([channelId, userId])
}

model DMThread {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userAId     String // 常に userAId < userBId になるよう正規化する
  userA       User     @relation("DMUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId     String
  userB       User     @relation("DMUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  lastReadAtA DateTime @default(now())
  lastReadAtB DateTime @default(now())

  messages Message[]

  @@unique([workspaceId, userAId, userBId])
}

model Message {
  id        String    @id @default(cuid())
  channelId String?
  channel   Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  dmId      String?
  dm        DMThread? @relation(fields: [dmId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Message?  @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Message[] @relation("ThreadReplies")

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  attachments Attachment[]
  reactions   Reaction[]
  mentions    Mention[]

  @@index([channelId, createdAt])
  @@index([dmId, createdAt])
  @@index([parentId])
}

model Attachment {
  id         String   @id @default(cuid())
  messageId  String?
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  storageKey String   @unique // uploads ディレクトリ内の実ファイル名（ランダム生成、パストラバーサル対策）
  fileName   String // 元のファイル名（表示用）
  mimeType   String
  sizeBytes  Int
  kind       String // "IMAGE" | "VIDEO"
  createdAt  DateTime @default(now())
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model Mention {
  id               String  @id @default(cuid())
  messageId        String
  message          Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUserId  String

  @@index([mentionedUserId])
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type        String // "MENTION" | "DM" | "CHANNEL_INVITE" | "WORKSPACE_INVITE"
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId   String?
  dmId        String?
  messageId   String?
  threadParentId String?
  fromUserId  String?
  fromUser    User?      @relation("NotificationSender", fields: [fromUserId], references: [id], onDelete: SetNull)
  text        String
  createdAt   DateTime   @default(now())
  readAt      DateTime?

  @@index([userId, readAt])
}
