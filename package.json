{
  "name": "chatspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @chatspace/web run dev",
    "dev:web": "pnpm --filter @chatspace/web run dev",
    "build": "pnpm --filter @chatspace/web run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @chatspace/web run test",
    "generate:api-types": "pnpm --filter @chatspace/web run generate:api-types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
