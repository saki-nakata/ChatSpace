# ===== バックエンド: apps/api (Java / Spring Boot) =====
# 環境変数として与えるか、apps/api/.env にコピーして使用する。
# ローカル開発では dev プロファイル(application-dev.yml)が既定値を持つため、
# 明示的な設定なしでも docker-compose.yml の PostgreSQL に接続できる。
DATABASE_URL_JDBC=jdbc:postgresql://localhost:5432/chatspace
DATABASE_USERNAME=chatspace
DATABASE_PASSWORD=
JWT_SECRET=
PORT=8080
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# --- 添付ファイルの保存先(フェーズ13、インフラ構成書§7.1) ---
# 未設定なら local(ローカルディスク、UPLOAD_DIRを使用)。s3 を指定するとCloudflare R2(S3互換)を使う。
#STORAGE_TYPE=local
# STORAGE_TYPE=s3 のときのみ必須(未設定のまま起動すると失敗する)。
#STORAGE_S3_BUCKET=
#STORAGE_S3_ENDPOINT=
#STORAGE_S3_REGION=auto
#STORAGE_S3_ACCESS_KEY_ID=
#STORAGE_S3_SECRET_ACCESS_KEY=

# --- 認証のレート制限(フェーズ12、認証機能定義書§7) ---
# 未設定なら application.yml の既定値(5回 / 15分ウィンドウ / 15分ブロック)が使われる。
# 値を空("KEY=")のままエクスポートすると、Springのプレースホルダ解決は既定値ではなく空文字列を
# 採用するため、int / Duration への変換に失敗して起動時エラーになる。既定値を使う場合は
# 行ごとコメントアウトしたままにし、変更するときだけコメントを外して値を入れること。
#AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
#AUTH_RATE_LIMIT_WINDOW=15m
#AUTH_RATE_LIMIT_BLOCK_DURATION=15m

# 新規登録のレート制限(クライアントIP単位。公開デモでの自動アカウント大量生成対策)。
# 上と同じ理由で、既定のままにする場合はコメントアウトしたままにすること。
#SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=10
#SIGNUP_RATE_LIMIT_WINDOW=1h
#SIGNUP_RATE_LIMIT_BLOCK_DURATION=1h

# --- ログ(フェーズ12、ログ運用設計書§1) ---
# LOG_STRUCTURED_FORMAT に logstash または ecs を設定すると構造化ログ(JSON)で出力される。
# 本番(Render)では logstash を設定し、ログ検索で requestId・userId・auditEvent を絞り込めるようにする。
# 未設定なら人間可読な行形式。上記と同じ理由(空文字列が既定値を上書きする)で、既定のままにする場合は
# コメントアウトしたままにすること。
#LOG_LEVEL=INFO
#LOG_LEVEL_APP=INFO
#LOG_STRUCTURED_FORMAT=logstash

# プロキシヘッダの解釈方法。既定は native(Tomcat RemoteIpValve、信頼済みプロキシからのみ X-Forwarded-For を反映)。
# プロキシを介さない構成では none を指定するとソケットの接続元アドレスがそのまま使われる。
#FORWARD_HEADERS_STRATEGY=native

# --- Swagger UI / OpenAPI の公開切り替え(フェーズ14) ---
# 未設定ならローカル開発と同じ既定の有効状態。本番(Render)ではエンドポイント形状の偵察を避けるため false にする。
#SWAGGER_ENABLED=true

# ===== フロントエンド: apps/web (React / Vite) =====
# apps/web/.env にコピーして使用する。
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
