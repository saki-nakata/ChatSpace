# ===== バックエンド: apps/api (Java / Spring Boot) =====
# 環境変数として与えるか、apps/api/.env にコピーして使用する。
# ローカル開発では dev プロファイル(application-dev.yml)が既定値を持つため、
# 明示的な設定なしでも docker-compose.yml の PostgreSQL に接続できる。
DATABASE_URL_JDBC=jdbc:postgresql://localhost:5432/chatspace
DATABASE_USERNAME=chatspace
DATABASE_PASSWORD=
JWT_SECRET=
PORT=8080
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# --- 認証のレート制限(フェーズ12、認証機能定義書§7) ---
# 未設定なら application.yml の既定値(5回 / 15分ウィンドウ / 15分ブロック)が使われる。
AUTH_RATE_LIMIT_MAX_ATTEMPTS=
AUTH_RATE_LIMIT_WINDOW=
AUTH_RATE_LIMIT_BLOCK_DURATION=

# --- ログ(フェーズ12、ログ運用設計書§1) ---
# LOG_STRUCTURED_FORMAT に logstash または ecs を設定すると構造化ログ(JSON)で出力される。
# 本番(Render)では logstash を設定し、ログ検索で requestId・userId・auditEvent を絞り込めるようにする。
# 未設定なら従来どおり人間可読な行形式。
LOG_LEVEL=
LOG_LEVEL_APP=
LOG_STRUCTURED_FORMAT=

# ===== フロントエンド: apps/web (React / Vite) =====
# apps/web/.env にコピーして使用する。
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
