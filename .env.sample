# ===== 新バックエンド: apps/api-java (Java / Spring Boot) =====
# 環境変数として与えるか、apps/api-java/.env にコピーして使用する。
# ローカル開発では dev プロファイル(application-dev.yml)が既定値を持つため、
# 明示的な設定なしでも docker-compose.yml の PostgreSQL に接続できる。
DATABASE_URL_JDBC=jdbc:postgresql://localhost:5432/chatspace
DATABASE_USERNAME=chatspace
DATABASE_PASSWORD=
JWT_SECRET=
PORT=8080
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# ===== 旧バックエンド: apps/api (Hono / Prisma / SQLite) =====
# Java版への移行完了後に削除する。apps/api/.env にコピーして使用する。
DATABASE_URL="file:./prisma/dev.db"
# JWT_SECRET / WEB_ORIGIN / UPLOAD_DIR は上記と同じキーを使用する
# PORT は旧APIでは 4000

# ===== 旧フロントエンド: apps/web (React / Vite) =====
# 旧API(apps/api, :4000)に接続する。apps/web/.env にコピーして使用する。
VITE_API_URL=http://localhost:4000

# ===== 新フロントエンド: apps/web-next (React / Vite、フェーズ9) =====
# 新API(apps/api-java, :8080)に接続する。apps/web-next/.env にコピーして使用する。
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
# 注意: 上記WEB_ORIGINの既定値(:5173)は旧apps/web用。apps/web-next(:5174)の動作確認時は
# apps/api-java起動時に WEB_ORIGIN=http://localhost:5174 を指定すること(CORS・WebSocket Origin許可)。
