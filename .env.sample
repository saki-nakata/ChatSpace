# ===== バックエンド: apps/api (Java / Spring Boot) =====
# 環境変数として与えるか、apps/api/.env にコピーして使用する。
# ローカル開発では dev プロファイル(application-dev.yml)が既定値を持つため、
# 明示的な設定なしでも docker-compose.yml の PostgreSQL に接続できる。
DATABASE_URL_JDBC=jdbc:postgresql://localhost:5432/chatspace
DATABASE_USERNAME=chatspace
DATABASE_PASSWORD=
JWT_SECRET=
PORT=8080
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# ===== フロントエンド: apps/web (React / Vite) =====
# apps/web/.env にコピーして使用する。
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
